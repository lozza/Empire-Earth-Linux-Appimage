#!/bin/sh
set -eu
APPDIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
export EE_BUILDER_DIR="$APPDIR"
case "${1:-}" in
  '') export LD_LIBRARY_PATH="$APPDIR/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"; exec "$APPDIR/usr/bin/empire-earth-builder-gui" ;;
  --build) shift; exec "$APPDIR/build-game.sh" "$@" ;;
  --check)
    test -x "$APPDIR/build-game.sh"
    test -x "$APPDIR/tools/innoextract/innoextract"
    test -f "$APPDIR/tools/magic.mgc"
    test -f "$APPDIR/configure-camera.sh"
    test -f "$APPDIR/camera-only.config"
    printf 'Builder tools present.\n' ;;
  --help|-h)
    printf 'Double-click for the builder window.\nCommand line: %s --build GOG_INSTALLER DIRECTMUSIC_CAB OUTPUT_FOLDER [720p|deck|1080p] [off|on] [LOCAL_DREXMOD_2_01_ZIP]\n' "$0" ;;
  *) printf 'Unknown option. Use --help.\n' >&2; exit 2 ;;
esac
